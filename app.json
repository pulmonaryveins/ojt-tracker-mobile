{
  "expo": {
    "name": "OJT Tracker",
    "slug": "ojt-tracker-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "ojttracker",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#5865f2"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.projectpransin.ojttracker",
      "associatedDomains": ["applinks:syekepcbxpenedsbufvb.supabase.co"],
      "infoPlist": {
        "NSCameraUsageDescription": "Allow OJT Tracker to access your camera to take session photos.",
        "NSPhotoLibraryUsageDescription": "Allow OJT Tracker to access your photos to upload session images.",
        "NSMicrophoneUsageDescription": "This app does not use the microphone."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5865f2"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.NOTIFICATIONS"
      ],
      "package": "com.projectpransin.ojttracker",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "syekepcbxpenedsbufvb.supabase.co",
              "pathPrefix": "/auth/v1/verify"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "ojttracker"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#5865f2"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow OJT Tracker to access your photos to upload session images.",
          "cameraPermission": "Allow OJT Tracker to access your camera to take session photos."
        }
      ],
      "expo-font",
      "expo-secure-store"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "42fd5633-da13-41a8-9931-c42511c9bbe4"
      }
    },
    "owner": "pulmonaryveins"
  }
}
